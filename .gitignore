# ============================================================
#  ACME 项目 .gitignore —— 通用多语言开发忽略规则
#  重要约定：
#   · .ai/ 是 AI 配置唯一事实源，其派生产物（.claude/ .cursor/ .gemini/
#     .iflow/ .trae/ .qoder/ .github/ 等）需要入库，切勿整体忽略。
#   · .ai-tmp/ 内容不入库，仅保留说明文件 ABOUT.md。
#   · 安全红线：密钥 / 凭证 / .env 一律不入库（公开模板用 .env.example）。
#   · 需要入库却被忽略的文件，用 git add -f 强制添加。
# ============================================================

# --- AI 工具个人本地配置（不入库，见各工具 README） ---
.claude/settings.local.json
AGENTS.local.md
CLAUDE.local.md
# ZCode 本地数据（工作流草稿、会话态等）
.zcode/
.ai-memory/drafts/*.local.md

# --- AI 临时文件（内容不入库，仅说明文件 ABOUT.md 入库） ---
.ai-tmp/*
!.ai-tmp/ABOUT.md
# --- AI 并行开发工作树（worktree.mjs 创建，不入库） ---
.worktrees/

# --- 密钥 / 凭证 / 环境变量（安全红线，严禁入库） ---
.env
.env.*
# env-stack 真实凭证（模板 *.example.env 保留；服务器侧放 /opt/acme/<env>/）
workspace/env-stack/config/app.env
workspace/env-stack/config/registry.env
!.env.example
!.env.template
!.env.sample
!.env.dist
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
.netrc
.git-credentials
.pypirc
secrets/
*.secret
*.secrets

# --- 操作系统 ---
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# Office 编辑锁文件（docs 文档被编辑时产生）
~$*

# --- 编辑器 / IDE ---
.idea/
.vscode/
.vs/
# IntelliJ 模块文件（散落在 .idea/ 之外）
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
.history/

