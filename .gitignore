# --- AI 工具个人本地配置（不入库，见各工具 README） ---
.claude/settings.local.json
AGENTS.local.md
CLAUDE.local.md
.ai-memory/drafts/*.local.md

# --- AI 临时文件（内容不入库，仅说明文件 ABOUT.md 入库） ---
.ai-tmp/*
!.ai-tmp/ABOUT.md

# --- 密钥与环境 ---
.env
.env.*
!.env.example
