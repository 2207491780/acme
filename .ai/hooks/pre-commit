#!/bin/sh
# 启用方式（一次性）：git config core.hooksPath .ai/hooks
if ! command -v node >/dev/null 2>&1; then
  echo "提交被拒绝：未检测到 Node，无法校验 AI 配置。"
  exit 1
fi
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
node .ai/sync.mjs --check || {
  echo "提交被拒绝：AI 配置未同步，请运行 node .ai/sync.mjs 并暂存源与派生产物。"
  exit 1
}

# 工作区同步不能证明暂存区同步；相关文件须完整暂存，禁止半份配置进入提交。
# 暂存清单唯一事实源：.ai/hooks/ai-paths.list（逐行读、# 与空行跳过），与 mirror-check.mjs、
# CI mirror-sync 作业同口径；一致性由 sync.mjs 与 .ai/tests/ai-paths.test.mjs 锁定
# （ADR 2026-11-14-22、2026-11-17-01）。钩子可能在任意 worktree 根执行，路径相对仓库根解析。
paths_file=".ai/hooks/ai-paths.list"
if [ ! -f "$paths_file" ]; then
  echo "提交被拒绝：缺少 $paths_file（AI 路径单一清单），请检查工作区完整性。"
  exit 1
fi
set --
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    ''|'#'*) continue ;;
  esac
  set -- "$@" "$line"
done < "$paths_file"
if ! git diff --quiet -- "$@"; then
  echo "提交被拒绝：AI 配置或派生产物仍有未暂存修改，请检查并逐项暂存后重试。"
  exit 1
fi
untracked=$(git ls-files --others --exclude-standard -- "$@") || exit 1
if [ -n "$untracked" ]; then
  echo "提交被拒绝：存在未跟踪的 AI 配置或派生产物，请检查并逐项暂存后重试。"
  exit 1
fi
