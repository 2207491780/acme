# @acme/web 静态站镜像 —— 构建上下文：apps/frontend/（pnpm workspace 根）
# 用法：
#   docker build -f Dockerfile.web -t $REGISTRY/acme/web:<tag> .
# 运行期：nginx 同源反代 /admin /app 到网关（web CSP 为 connect-src 'self'，禁止跨域直连）
FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable

# 先拷清单做依赖缓存层；pnpm workspace 的 lockfile 覆盖全部成员，需齐拷各 package.json
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/core/package.json packages/core/
COPY web/package.json web/
COPY desktop/package.json desktop/
COPY mobile/package.json mobile/
RUN pnpm install --frozen-lockfile --filter @acme/web...

COPY packages/core packages/core
COPY web web
RUN pnpm --filter @acme/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /repo/web/dist /usr/share/nginx/html
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
