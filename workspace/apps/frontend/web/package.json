{
  "name": "@acme/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ACME 多端前端交付台 Web 端（React + Ant Design）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
