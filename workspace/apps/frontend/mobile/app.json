{
  "expo": {
    "name": "ACME 交付台",
    "slug": "acme-frontend-ops",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "acme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#14161a",
    "icon": "./assets/icon.png",
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#5aa7a0"
    },
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#14161a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.acme.frontendops"
    },
    "android": {
      "package": "com.acme.frontendops",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5aa7a0"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "acme"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
