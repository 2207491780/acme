{
  "name": "@acme/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "description": "ACME 多端前端交付台移动端（React Native + Expo，共享 @acme/core）",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:dev": "npx --yes eas-cli@latest build -p android --profile development",
    "build:preview": "npx --yes eas-cli@latest build -p android --profile preview"
  },
  "dependencies": {
    "@acme/core": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.49",
    "expo-asset": "11.0.5",
    "expo-camera": "~16.0.18",
    "expo-font": "13.0.4",
    "expo-secure-store": "~14.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "jsdom": "^25.0.1",
    "react-dom": "18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.13"
  }
}
