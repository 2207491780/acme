<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acme</groupId>
        <artifactId>acme-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>framework-trace</artifactId>
    <packaging>jar</packaging>
    <name>framework-trace</name>
    <description>
        链路追踪模块（Modules.md 3.1）：traceId 生成与 MDC、HTTP / Feign / Stream 三通道透传、日志 pattern；
        四包形态与开关见 Modules.md 3.5
    </description>

    <dependencies>
        <!-- 架构设计 2.2 依赖矩阵：trace → core + common（单向，Backend.md 4.4.1） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-context</artifactId>
        </dependency>
        <!-- BR-013：trace 常量取自 common-contract -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-contract</artifactId>
        </dependency>

        <!-- Modules.md 3.5 依赖粒度：Boot 4 细粒度模块，禁大而全 starter（BR-009） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 三通道 optional（架构设计 2.2、DQ-002/003）：未用通道不落入使用方传递树，条件装配隔离类加载 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-messaging</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试域（不引大而全 starter-test，framework-core 先例） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- AC-006 日志捕获断言 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- AC-001 web 测试环境（架构设计 8 测试设计；Boot 4 细粒度 web 模块） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
