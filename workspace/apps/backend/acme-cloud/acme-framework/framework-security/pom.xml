<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acme</groupId>
        <artifactId>acme-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>framework-security</artifactId>
    <packaging>jar</packaging>
    <name>framework-security</name>
    <description>
        下游侧安全模块（Modules.md 3.1）：内部令牌校验、令牌类型与端别声明校验、权限解析、
        数据权限拦截（机制+扩展点，Q-D004）、上下文统一写入与清理；四包形态与开关见 Modules.md 3.5
    </description>

    <dependencies>
        <!-- 架构设计 4.1 依赖矩阵：security → core、trace（第 3 层，BR-001/BR-002） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-trace</artifactId>
        </dependency>
        <!-- 实引用直接声明（Modules.md 2.2.3/3.1 v1.7）：上下文/契约基元 -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-contract</artifactId>
        </dependency>

        <!-- Servlet 过滤器 optional（framework-trace 同型，7.0） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 数据权限 AOP（FR-017，Q-D09） -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <!-- 内部令牌 JWS HS256（Q-D01；jjwt-jackson 的 Jackson 2 隔离 internal，Modules.md 3.5） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 测试域（不引大而全 starter-test，framework-core 先例） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockHttpServletRequest/Response 需要 spring-web（仅测试域） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
