<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acme</groupId>
        <artifactId>acme-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>framework-mybatis-flex</artifactId>
    <packaging>jar</packaging>
    <name>framework-mybatis-flex</name>
    <description>
        数据访问增强模块（Modules.md 3.1，底座 MyBatis-Flex 1.11.8 Boot 4 starter）：审计字段填充、软删除、乐观锁、
        慢 SQL 与绑定参数日志；不建业务表（BR-022）；四包形态与开关见 Modules.md 3.5
    </description>

    <dependencies>
        <!-- 架构设计 4.1 依赖矩阵：flex → core（第 2 层，BR-001/BR-002） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-core</artifactId>
        </dependency>
        <!-- 雪花 IdGenerator（12.1） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-util</artifactId>
        </dependency>
        <!-- 实引用直接声明（Modules.md 2.2.3/3.1） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-core</artifactId>
        </dependency>

        <!-- MyBatis-Flex（Boot 4 专用 starter，POC 验证冻结 1.11.8）：含 mybatis-flex-core、mybatis-spring、spring-jdbc -->
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 测试域（不引大而全 starter-test，framework-core 先例） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 测试内联 DataSource 自动装配（Boot 4 细粒度模块；生产经服务侧 starter-jdbc 传递） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 隔离测试环境（15 章测试设计 6：等效隔离环境） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
