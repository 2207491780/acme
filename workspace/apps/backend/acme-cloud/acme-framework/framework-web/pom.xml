<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acme</groupId>
        <artifactId>acme-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>framework-web</artifactId>
    <packaging>jar</packaging>
    <name>framework-web</name>
    <description>
        Web 接入模块（Modules.md 3.1）：统一出参包装、全局异常、校验错误映射、服务侧访问日志、
        ClientContext 解析（B/C、deviceId）；四包形态与开关见 Modules.md 3.5；无 CORS（BR-011）
    </description>

    <dependencies>
        <!-- 架构设计 4.1 依赖矩阵：web → core、jackson、trace（第 3 层，BR-001/BR-002） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-trace</artifactId>
        </dependency>
        <!-- 实引用直接声明（Modules.md 2.2.3/3.1 v1.7）：上下文/契约基元 -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-contract</artifactId>
        </dependency>

        <!-- Modules.md 3.5 依赖粒度：Boot 4 细粒度模块，禁大而全 starter（BR-023） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>
        <!-- 校验错误映射需要约束违规类型（FR-005） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- 测试域（不引大而全 starter-test，framework-core 先例） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 日志捕获断言（AC-006 形态） -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
