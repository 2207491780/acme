            <!-- 服务契约模块（18.1.1 第 3 步登记；G2.5 首批：platform-auth / platform-system） -->
            <dependency>
                <groupId>com.acme</groupId>
                <artifactId>platform-auth-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.acme</groupId>
                <artifactId>platform-auth-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.acme</groupId>
