                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.acme</groupId>
                <artifactId>platform-system-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- platform-infra 增补登记（platform-infra-audit 拆分评审，18.1.1 第 3 步） -->
            <dependency>
                <groupId>com.acme</groupId>
                <artifactId>platform-infra-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.acme</groupId>
