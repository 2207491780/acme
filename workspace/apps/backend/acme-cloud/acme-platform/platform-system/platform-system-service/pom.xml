<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acme</groupId>
        <artifactId>platform-system</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>platform-system-service</artifactId>
    <packaging>jar</packaging>
    <name>platform-system-service</name>
    <description>
        系统管理域服务实现与启动入口（FR-006~009；架构设计 9.1 装配：core / jackson / trace / web / mybatis-flex /
        security / tenant；i18n 双语 NFR-007；未用不声明——cache / lock / stream / job / gateway 不引入）。
        REQ-20261114-120102 消息通知闭环一期增补：WebSocket（站内信实时推送）+ Redis（pub/sub 多实例扇出）。
        REQ-20261117-025200 增补：system → auth 单向撤销契约消费（framework-feign + openfeign runtime，
        停用租户事务提交后批量撤销会话）
    </description>

    <dependencies>
        <!-- 本服务契约 -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>platform-system-api</artifactId>
        </dependency>
        <!-- 服务间依赖（REQ-20261117-025200 确认记录②：system → auth 单向，仅经 *-api，4.4.2；
            供停用租户后会话批量撤销（提供方 platform-auth，撤销端点 internal 不经网关）） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>platform-auth-api</artifactId>
        </dependency>
        <!-- 服务间依赖（REQ-20261119-011524 确认记录①③：system → infra 单向，仅经 *-api，4.4.2；
            供首页概览聚合审计动作分布（提供方 platform-infra，统计端点 internal 不经网关；
            infra 消费 auth-api 先例反向对称，system 为三向消费聚合域）） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>platform-infra-api</artifactId>
        </dependency>
        <!-- framework 按需（Modules.md 3.1；架构设计 9.1） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-mybatis-flex</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-security</artifactId>
        </dependency>
        <!-- REQ-20261117-061017 确认③：B 端管理写端点 @AuditLog 补注（含 beforeQuery 旧值快照） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-audit</artifactId>
        </dependency>
        <!-- Feign 出站支撑（REQ-20261117-025200：内部令牌注入 / 错误解码 / 熔断，
            同 platform-auth-service 装配口径；契约声明在 platform-auth-api） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-feign</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-tenant</artifactId>
        </dependency>
        <!-- 租户配额平台缺省值绑定（REQ-20261122-150802 确认③：仅 StorageProperties 读
            acme.storage.quota.default-bytes 单源；适配器装配面经 acme.storage.enabled=false 关闭，
            对象存储仍归 platform-infra 文件域） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-storage</artifactId>
        </dependency>
        <!-- zh/en 双语（NFR-007、Q-007 裁定 B） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-i18n</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-i18n</artifactId>
        </dependency>
        <!-- 实引用直接声明（Modules.md 2.2.3） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-util</artifactId>
        </dependency>

        <!-- Web 运行时（Boot 4 细粒度模块；p4 先例）：内嵌容器 spring-boot-tomcat（带 web-server 抽象——
            缺容器时应用降级非 Web 上下文，SCA 注册监听器解析 WebServerInitializedEvent 失败）
            + hibernate-validator / tomcat-embed-el 供接口层 @Valid 真实校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-tomcat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-el</artifactId>
        </dependency>

        <!-- WS 实时推送（REQ-20261114-120102，已登记 project.md）：站内信推送端点 /ws/system/notify -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- 推送扇出 Redis pub/sub（复用 Redis 基建，L1InvalidationBus 先例；键前缀 system 服务名，12.3.2） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-redis</artifactId>
        </dependency>

        <!-- OpenFeign 运行时（REQ-20261117-025200；Feign 契约声明在 platform-auth-api，
            装配注释口径同 platform-auth-service） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 数据访问与迁移（12.3.3 Flyway 同仓；12.1.1 独占 schema platform_system） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 自动配置（Boot 4 细粒度模块） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 连接池（Boot 4 细粒度模块不含池；DataSourceAutoConfiguration 缺池不装配） -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!-- Nacos 注册与配置中心（FR-018、14.3.1） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- 健康探针与指标（FR-019、14.2；架构设计 9.5）：starter 含 spring-boot-health / actuator-autoconfigure——
            Boot 4 起 HealthIndicator 在 health 独立模块，裸 spring-boot-actuator 会使 SCA nacos 端点自动配置 introspect 失败 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- 测试域（16 章；common-test 为测试栈载体，test scope 引入） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers PG（集成测试本地可执行，16.2.1 不依赖共享库） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 可执行 jar 附加 -exec 分类器（REQ-20261118-002130 确认②）：主构件保持普通 jar
                        形态供 acme-bootstrap 单体聚合编译/打包（Boot 重打包的 BOOT-INF 布局不可作为
                        依赖 jar 复用）；镜像构建（Dockerfile）按 -exec 优先取可执行 jar，行为不变 -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <!-- Flex 全局默认方言是 JVM 级静态（FlexGlobalConfig.defaultConfig），H2 与 MySQL 共用反引号方言。
                 本模块 H2 切片（FlexRepositorySliceTest）与 PG 集成（SystemIntegrationTest）若共用 surefire JVM，
                 全局方言会被先建的 H2 上下文污染，致 PG 生成反引号 SQL 报 syntax error。每个测试类独立 JVM 隔离。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
