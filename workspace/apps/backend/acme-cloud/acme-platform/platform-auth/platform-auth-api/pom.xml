<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acme</groupId>
        <artifactId>platform-auth</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>platform-auth-api</artifactId>
    <packaging>jar</packaging>
    <name>platform-auth-api</name>
    <description>
        认证域服务契约（Backend.md 9.1；架构设计 9.2：本期无服务间消费方，薄契约）：
        AdminTokenIssued / AdminPasswordSetRequest DTO + 预留枚举；错误码文本常量供消费方判定
    </description>

    <dependencies>
        <!-- 契约基元（9.1.2：* -api 允许 common-*） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <!-- DTO 校验注解（jakarta.validation-api，非 Web 容器） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- 测试域 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 9.1.2 / 17.1 / M-11：* -api 禁 Web 容器与 ORM（18.1.1 第 4 步） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-api-no-web-orm</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- Web 容器 -->
                                        <exclude>org.springframework.boot:spring-boot-starter-web</exclude>
                                        <exclude>org.springframework.boot:spring-boot-webmvc</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-webflux</exclude>
                                        <exclude>org.springframework.boot:spring-boot-webflux</exclude>
                                        <exclude>org.springframework:spring-webmvc</exclude>
                                        <exclude>org.springframework:spring-webflux</exclude>
                                        <exclude>org.springframework:spring-web</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-openfeign-core</exclude>
                                        <exclude>jakarta.servlet:*</exclude>
                                        <!-- ORM 与数据访问 -->
                                        <exclude>org.springframework.boot:spring-boot-data-jpa</exclude>
                                        <exclude>org.springframework.boot:spring-boot-data-redis</exclude>
                                        <exclude>org.springframework.data:*</exclude>
                                        <exclude>org.hibernate:*</exclude>
                                        <exclude>com.querydsl:*</exclude>
                                        <exclude>org.flywaydb:*</exclude>
                                    </excludes>
                                    <message>platform-auth-api 禁止 Web 容器与 ORM 依赖（9.1.2、M-11）</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
