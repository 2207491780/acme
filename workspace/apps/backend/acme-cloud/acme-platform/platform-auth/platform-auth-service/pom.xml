<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acme</groupId>
        <artifactId>platform-auth</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>platform-auth-service</artifactId>
    <packaging>jar</packaging>
    <name>platform-auth-service</name>
    <description>
        认证域服务实现与启动入口（FR-001~005；架构设计 9.1 装配：core / jackson / trace / web / jpa / security /
        feign（画像与权限判定）+ i18n；未用不声明——tenant / cache / lock / stream / job / gateway 不引入：
        auth 表含 tenant_id 列但不参与过滤，Q-D04）
    </description>

    <dependencies>
        <!-- 本服务契约 -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>platform-auth-api</artifactId>
        </dependency>
        <!-- 唯一服务间依赖（auth → system 单向，仅经 *-api，4.4.2 / M-02） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>platform-system-api</artifactId>
        </dependency>
        <!-- framework 按需（Modules.md 3.1；架构设计 9.1） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-feign</artifactId>
        </dependency>
        <!-- zh/en 双语（NFR-007、Q-007 裁定 B） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>framework-i18n</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-i18n</artifactId>
        </dependency>
        <!-- 实引用直接声明（Modules.md 2.2.3） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-contract</artifactId>
        </dependency>

        <!-- Web 运行时（Boot 4 细粒度模块；p4 先例）：内嵌容器 spring-boot-tomcat（带 web-server 抽象——
            缺容器时应用降级非 Web 上下文，SCA 注册监听器解析 WebServerInitializedEvent 失败）
            + hibernate-validator / tomcat-embed-el 供接口层 @Valid 真实校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-tomcat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-el</artifactId>
        </dependency>

        <!-- OpenFeign 运行时（Feign 契约声明在 platform-system-api；9.1.2） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- 防爆破 / 会话撤销 Redis（架构设计 4.2；键前缀 auth:，12.3.2） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-redis</artifactId>
        </dependency>
        <!-- 凭据散列 BCrypt（FR-005；cost 10） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- 用户令牌签发 JWS HS256（4.1；jjwt-jackson 的 Jackson 2 触碰面收敛 internal 包，Modules.md 3.5 同型） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>
        <!-- 数据访问与迁移（12.3.3；schema platform_auth） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 自动配置（Boot 4 细粒度模块） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 连接池（Boot 4 细粒度模块不含池；DataSourceAutoConfiguration 缺池不装配） -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!-- Nacos 注册与配置中心（FR-018） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- 健康探针与指标（FR-019、14.2；架构设计 9.5）：starter 含 spring-boot-health / actuator-autoconfigure——
            Boot 4 起 HealthIndicator 在 health 独立模块，裸 spring-boot-actuator 会使 SCA nacos 端点自动配置 introspect 失败 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- 测试域（16 章） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers PG + Redis（集成测试本地可执行，16.2.1） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
