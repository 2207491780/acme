<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acme</groupId>
        <artifactId>platform-workflow</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>platform-workflow-api</artifactId>
    <packaging>jar</packaging>
    <name>platform-workflow-api</name>
    <description>
        BPM 工作流域服务契约（REQ-20261121-142316；docs/bpm-engine-design-2026-11-21 §2/§4/§7 协议）：
        定义/实例/任务三域 Admin DTO、internal fire/callback 协议 DTO、域共享枚举与错误码常量
        （服务间唯一编译期依赖入口，M-11 禁实现与 Web/ORM）。ServiceTask 委托协议与定时联动
        协议的入参形态在 BPM-1 契约钉死（BPM-5/BPM-6 消费）。REQ-20261122-233425 增补：
        WorkflowRuntimeClient 运行时契约（internal 启动/详情/变量写）与 WorkflowEventEnvelope
        事件载荷（acme.workflow.events 消费面）。
    </description>

    <dependencies>
        <!-- 契约基元（9.1.2：*-api 允许 common-* 与 spring-cloud-openfeign-core） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>common-contract</artifactId>
        </dependency>
        <!-- DTO 校验注解（jakarta.validation-api，非 Web 容器） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- WorkflowRuntimeClient Feign 契约（REQ-20261122-233425 确认②③；spring-web 注解面经其传递属契约声明面） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-openfeign-core</artifactId>
        </dependency>
        <!-- 服务间响应信封（ContractResult 消费解码；4.4.2 api→api 单向无环——system-api 仅依赖 common-*） -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>platform-system-api</artifactId>
        </dependency>

        <!-- 测试域 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 9.1.2 / 17.1 / M-11：*-api 禁 Web 容器与 ORM（18.1.1 第 4 步） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-api-no-web-orm</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- Web 容器 -->
                                        <exclude>org.springframework.boot:spring-boot-starter-web</exclude>
                                        <exclude>org.springframework.boot:spring-boot-webmvc</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-webflux</exclude>
                                        <exclude>org.springframework.boot:spring-boot-webflux</exclude>
                                        <exclude>org.springframework:spring-webmvc</exclude>
                                        <exclude>org.springframework:spring-webflux</exclude>
                                        <exclude>jakarta.servlet:*</exclude>
                                        <!-- ORM 与数据访问 -->
                                        <exclude>org.springframework.boot:spring-boot-data-jpa</exclude>
                                        <exclude>org.springframework.boot:spring-boot-data-redis</exclude>
                                        <exclude>org.springframework.data:*</exclude>
                                        <exclude>org.hibernate:*</exclude>
                                        <exclude>com.querydsl:*</exclude>
                                        <exclude>org.flywaydb:*</exclude>
                                    </excludes>
                                    <message>platform-workflow-api 禁止 Web 容器与 ORM 依赖（9.1.2、M-11）</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
