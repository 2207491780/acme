# 镜像仓库凭证模板 —— 复制到服务器 /opt/acme/<env>/registry.env 并填真实值（严禁入库）
# deploy.sh 消费：REGISTRY 用于 kustomize edit set image 与 docker-registry secret

# 阿里云 ACR 个人版示例（地域按实际替换）
REGISTRY=registry.cn-hangzhou.aliyuncs.com/acme-demo
REGISTRY_USERNAME=change_me
REGISTRY_PASSWORD=change_me

# 可选：镜像 tag 覆盖（默认 dev-latest / test-latest / prod-latest）
# ACME_IMAGE_TAG=dev-latest
