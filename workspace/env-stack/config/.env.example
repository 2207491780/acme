# Acme 开发依赖环境变量模板
# 用法：复制为 env-stack/docker/dev/.env 并填本地取值（.env 不入库，见根 .gitignore；凭证不硬编码）
# 说明：所有服务端口仅绑定 127.0.0.1，仅本机可访问。
# 注：本文件为 docker/dev/.env.example 的镜像副本（本目录按 ENV-STACK.md 存放配置模板）；
#     改动请改 docker/dev/.env.example，本副本由其同步，避免两份漂移。

# ---- PostgreSQL ----
PG_PORT=5432
PG_USER=acme
PG_PASSWORD=change-me
PG_DB=acme

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ---- Nacos ----
NACOS_PORT=8848
# gRPC 端口 = NACOS_PORT + 1000，Nacos 2.x/3.x 客户端必需，勿省略
NACOS_GRPC_PORT=9848
# Nacos 3.x 控制台端口（8848 只承载服务 API）
NACOS_CONSOLE_PORT=8080
# Nacos 3.x 镜像强制要求（即使关闭鉴权）：令牌需 Base64
# 生成：echo -n "<32字符以上密钥>" | base64
NACOS_AUTH_TOKEN=change-me-base64
NACOS_AUTH_IDENTITY_KEY=change-me
NACOS_AUTH_IDENTITY_VALUE=change-me
# 控制台/管理 API 登录账号（3.x 不建默认用户，初始化见 nacos/README.md）
NACOS_USERNAME=change-me
NACOS_PASSWORD=change-me

# ---- Kafka ----
KAFKA_PORT=9092

# ---- RocketMQ（nameserver + broker；poc-gate POC-3 前置，仅开发用） ----
ROCKETMQ_VERSION=5.3.1
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_FAST_PORT=10909

# ---- 新增组件的变量追加在此 ----
