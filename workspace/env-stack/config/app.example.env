# 应用密钥模板 —— 复制到服务器 /opt/acme/<env>/app.env 并填真实值（严禁入库/入镜像/入 CI 日志）
# 命名与 .ai/ci/CI-GUIDE.md Secrets 约定对齐；deploy.sh 用 --from-env-file 整体注入为 acme-app-secrets
# 服务侧消费点：platform-*/application.yml（${PG_PASSWORD}/${REDIS_PASSWORD}/${NACOS_PASSWORD}）、
# 网关 yml（${ACME_USER_TOKEN_HMAC_SECRET}/${ACME_SECURITY_TOKEN_HMAC_SECRET}）、
# platform-auth Flyway 种子密码（下方 ACME_SEED_*，均无仓库内缺省值——缺键即启动失败，逐键必填）

# PostgreSQL（postgres StatefulSet 初始化 + 三个 platform 服务数据源）
PG_PASSWORD=change_me_pg_2026

# Redis（requirepass；服务侧 ${REDIS_PASSWORD}）
REDIS_PASSWORD=change_me_redis_2026

# Nacos（当前 dev/test 关闭鉴权仍需占位；开启鉴权后为真实凭证）
NACOS_PASSWORD=change_me_nacos_2026

# 令牌 HMAC 密钥（≥32 字节随机串；签发方 platform-auth 与网关校验须同值域隔离）
# 生成示例：openssl rand -hex 32
ACME_USER_TOKEN_HMAC_SECRET=change_me_replace_with_openssl_rand_hex_32
ACME_SECURITY_TOKEN_HMAC_SECRET=change_me_replace_with_openssl_rand_hex_32

# 超管种子密码（platform-auth V2 迁移经 pgcrypto 散列落库；首次建库后修改走改密接口）
ACME_SEED_SUPERADMIN_PASSWORD=change_me_superadmin_2026

# B 端演示账号种子密码（platform-auth V4 迁移；无缺省值，缺键即启动失败）
ACME_SEED_DEMO_ADMIN_PASSWORD=change_me_demo_admin_2026
ACME_SEED_DEMO_OPERATOR_PASSWORD=change_me_demo_operator_2026
